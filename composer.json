{
    "name": "kebindong/mobile-tab",
    "description": "SugarAsian fork: custom mobile tab with Reports button",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
    "source": "https://github.com/kebindong/mobile-tab",
    "issues": "https://github.com/kebindong/mobile-tab/issues"
    },

    "require": {
        "flarum/core": "^1.8"
    },
    "authors": [
        {
            "name": "KBD",
            "homepage": "https://github.com/kebindong",
            "role": "Maintainer"
        }
    ],
    "extra": {
        "flarum-extension": {
            "title": "SA Mobile tab",
            "category": "theme",
            "icon": {
                "name": "fas fa-ellipsis-h",
                "backgroundColor": "#0F9D58",
                "color": "#fff"
            }
        },
        "optional-dependencies": [
            "flarum/tags"
        ],
        "flarum-cli": {
            "modules": {
                "admin": false,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": false,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": true,
                "styleci": true,
                "css": true
            }
        }
    }
}
